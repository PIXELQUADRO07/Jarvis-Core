  "voice_sentence_silence": 0.05,
  "enable_weather": true,
  "enable_wiki": true,
  "enable_math": true,
  "enable_scraper": true,
  "enable_system": true,
  "enable_web_search": true,
  "weather_cache_ttl": 3600,
  "encrypt_memory": false,
  "encryption_key_file": ".jarvis_key",
