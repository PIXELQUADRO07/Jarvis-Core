{
  "ollama_url": "http://localhost:11434/api/chat",
  "model": "qwen2.5:7b",
  "temperature": 0.2,
  "max_response_length": 2000,
  "request_timeout": 120,
  "memory_file": "memory.json",
  "max_history_messages": 100,
  "db_file": "db/jarvis.db",
  "memory_cleanup_days": 30,
  "show_banner": true,
  "show_timestamps": true,
  "spinner_speed": 0.12,
  "render_markdown": true,
